{
  "name": "SowDeliverable",
  "type": "object",
  "properties": {
    "sow_id": {
      "type": "string",
      "description": "Reference to the parent SOW"
    },
    "name": {
      "type": "string",
      "description": "Name or description of the deliverable"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Technical",
        "Documentation",
        "Support",
        "Training",
        "Configuration",
        "Deployment",
        "Reporting",
        "Other"
      ],
      "default": "Other"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "overdue"
      ],
      "default": "pending"
    },
    "acceptance_criteria": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium"
    },
    "source_section": {
      "type": "string"
    },
    "extraction_confidence": {
      "type": "number"
    },
    "extracted_from_pdf": {
      "type": "boolean",
      "default": false
    },
    "source_document_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "sow_id",
    "name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}