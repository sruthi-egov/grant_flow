{
  "name": "MouCommitment",
  "type": "object",
  "properties": {
    "mou_id": {
      "type": "string",
      "description": "Reference to the parent MOU"
    },
    "name": {
      "type": "string",
      "description": "Short title of the commitment"
    },
    "description": {
      "type": "string",
      "description": "Full description of the commitment"
    },
    "commitment_type": {
      "type": "string",
      "enum": [
        "Operational",
        "Legal",
        "Reporting",
        "Financial",
        "Confidentiality",
        "Governance",
        "Collaboration",
        "Other"
      ],
      "default": "Operational"
    },
    "responsible_party": {
      "type": "string",
      "enum": [
        "eGov",
        "Partner",
        "Both Parties",
        "Other"
      ],
      "default": "Both Parties"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "frequency": {
      "type": "string",
      "description": "e.g. Yearly, Quarterly, As needed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "overdue"
      ],
      "default": "pending"
    },
    "source_section": {
      "type": "string"
    },
    "source_clause": {
      "type": "string"
    },
    "source_page": {
      "type": "string"
    },
    "extraction_confidence": {
      "type": "number"
    },
    "extracted_from_pdf": {
      "type": "boolean",
      "default": false
    },
    "source_document_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "mou_id",
    "name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}