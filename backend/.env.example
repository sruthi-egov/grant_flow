# ─────────────────────────────────────────────────────────────────────────────
# GrantOS backend configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored — never commit real secrets.
#   PowerShell:  Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Host port 55432 is used instead of the default 5432 so this stack never
# collides with a PostgreSQL you already run locally.
# When the backend itself runs inside Docker Compose, the host/port become
# `postgres:5432` — compose injects that automatically.
DATABASE_URL=postgresql://grantos:grantos_local_dev@localhost:55432/grantos?schema=public

# ─── Authentication ──────────────────────────────────────────────────────────
# MUST be replaced with long random values outside local development.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-before-any-shared-deployment
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-before-any-shared-deployment
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seeded demo accounts. Change the password before exposing this app to anyone.
SEED_ADMIN_EMAIL=admin@grantos.local
SEED_ADMIN_PASSWORD=DemoAdmin!2026
SEED_USER_EMAIL=analyst@grantos.local
SEED_USER_PASSWORD=DemoUser!2026

# ─── File storage ────────────────────────────────────────────────────────────
# Directory for uploaded documents. Mounted as a Docker volume in compose so
# uploads survive container restarts.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# ─── Email (local capture) ───────────────────────────────────────────────────
# Defaults point at Mailpit from docker-compose: nothing leaves your machine.
# Leave SMTP_USER/SMTP_PASS empty for Mailpit (it accepts unauthenticated mail).
#
# DEFAULT (local capture): points at Mailpit from docker-compose. Every message
# is captured at http://localhost:8025 and NOTHING is delivered to anyone.
# Leave SMTP_USER / SMTP_PASS empty — Mailpit accepts unauthenticated mail.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# TO SEND REAL EMAIL, replace the five values above with your provider's.
# Only these five change; nothing else in the app needs touching.
#
#   Provider            SMTP_HOST                 PORT  SECURE  USER            PASS
#   ------------------  ------------------------  ----  ------  --------------  --------------------------
#   Microsoft 365       smtp.office365.com        587   false   full mailbox    mailbox or app password
#   Google Workspace    smtp.gmail.com            587   false   full address    16-char App Password*
#   Amazon SES          email-smtp.<region>...    587   false   SES SMTP user   SES SMTP password
#   SendGrid            smtp.sendgrid.net         587   false   literal "apikey" the API key
#   Mailgun             smtp.mailgun.org          587   false   postmaster@...  the SMTP password
#
#   * Google requires 2-Step Verification and an App Password; a normal account
#     password will be rejected.
#   Use port 465 with SMTP_SECURE=true only if your provider requires implicit TLS.

# The From address. Many providers reject mail whose From domain they do not
# own, so set this to an address on your sending domain.
MAIL_FROM_NAME=GrantOS Notifications
MAIL_FROM_ADDRESS=notifications@grantos.local

# Safety net: mail to any address outside these domains is REFUSED, not sent.
# This is what stops demo data from emailing real people by accident.
# Add a recipient's domain here before inviting them for real.
# Comma-separated. An empty value removes the restriction entirely — only do
# that once you are certain the data is real.
MAIL_ALLOWED_DOMAINS=grantos.local,example.com,example.org

# ─── Scheduled notifications ─────────────────────────────────────────────────
# Base44 ran this daily at 03:30 UTC = 09:00 Asia/Kolkata.
NOTIFICATIONS_CRON_ENABLED=true
NOTIFICATIONS_CRON=30 3 * * *
NOTIFICATIONS_TIMEZONE=Asia/Kolkata

# ─── Public application URL ──────────────────────────────────────────────────
# The address recipients will click in invitation and notification emails.
#
# IMPORTANT: http://localhost:5173 only resolves on THIS machine. If you invite
# someone on another computer, the link in their email will not reach your app.
# Set this to an address they can actually open (a LAN IP, a tunnel, or a
# deployed hostname) BEFORE sending real invitations.
# The backend logs a warning at startup if this is localhost while real SMTP is
# configured, because that combination produces unusable links.
APP_PUBLIC_URL=http://localhost:5173

# ─── Invitations ─────────────────────────────────────────────────────────────
# How long an invitation link stays valid. Links are single-use regardless.
INVITATION_EXPIRY_DAYS=7

# ─── AI / document extraction ────────────────────────────────────────────────
# OPTIONAL. Without a key the app runs normally and extraction endpoints return
# an explicit "not configured" error — they never fabricate results.
# The key is read only here, on the backend, and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# Max characters of extracted PDF text sent to the model per request.
AI_MAX_INPUT_CHARS=120000

# ─── Kubernetes / deployment (unused locally) ────────────────────────────────
# Kept configurable so the same image can be deployed later.
K8S_NAMESPACE=grantos
